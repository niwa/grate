! =======================================================================
! Print Options
! =======================================================================
  NPRTF = 100  ! print output every NPRTF*DT secs    (default = 300)
  OUTXSPARMS = 0  ! Flag to enable output of cross-section information 
                                                         !  (outxsparms: 0=Disable;1=Enable)
  
  
! =======================================================================
! Display Options
! =======================================================================
  SedAccum = 1             ! Units of sediment accumulator display (0=kt, 1=kg)
  ProfYAxisLimitsAuto = 0      	 ! Automatically set limits to Y axis in Profile plot (0/1 = No/Yes,  Default=Yes)
  ProfYmax = 1      	! Manual override for ymax (only used if ProfYLimitsAuto=0)
  ProfYmin = -0.5     	 ! Manual override for ymin (only used if ProfYLimitsAuto=0)
  ProfYint = 0.5      	! Manual override for y-interval (only used if ProfYLimitsAuto=0)   
!
! =======================================================================
! Hydraulic calibration data: bankful level, water surface profiles 
! - for plotting purposes only
! =======================================================================
!
NCALIB = 0		! Number of profiles
NCALPTS =0 		' Number of points in each profile
